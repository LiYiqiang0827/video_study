# A code-only skill/tool repository: inputs, media, outputs and runtimes live elsewhere.
*
!.gitignore
!README.md
!SKILL.md
!requirements*.txt
!scripts/
!scripts/*.py
!scripts/export_video_analysis_pptx.mjs
!agents/
!agents/*.yaml
!references/
!references/*.md
!prompts/
!prompts/*.md
**/__pycache__/
**/*.pyc
**/.DS_Store

# HarryWu branch: curated research, source code and bounded examples.
!AGENTS.md
!.gitattributes
!harrywu/
!harrywu/**
harrywu/**/__pycache__/
harrywu/**/.pytest_cache/
harrywu/**/.venv/
harrywu/**/.env
harrywu/**/secrets.env
harrywu/**/cookies.txt
harrywu/**/*.pyc
harrywu/**/*.mp4
harrywu/**/*.mkv
harrywu/**/*.wav
harrywu/**/*.m4a
harrywu/**/*.db
harrywu/**/*.duckdb

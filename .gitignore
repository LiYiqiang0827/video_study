# Only maintained code, skill metadata, and Markdown documentation enter Git.
*
# Local scratch space is deliberately never versioned.
/tmp/
!.gitignore
!README.md
!video_download/
!video_download/README.md
!video_download/SKILL.md
!video_download/.gitignore
!video_download/requirements*.txt
!video_download/agents/
!video_download/agents/*.yaml
!video_download/references/
!video_download/references/*.md
!video_download/prompts/
!video_download/prompts/*.md
!video_download/scripts/
!video_download/scripts/*.py
!video_download/scripts/*.mjs
!video_download/scripts/requirements*.txt
!audio_subtitles/
!audio_subtitles/README.md
!audio_subtitles/SKILL.md
!audio_subtitles/.gitignore
!audio_subtitles/requirements*.txt
!audio_subtitles/agents/
!audio_subtitles/agents/*.yaml
!audio_subtitles/references/
!audio_subtitles/references/*.md
!audio_subtitles/prompts/
!audio_subtitles/prompts/*.md
!audio_subtitles/scripts/
!audio_subtitles/scripts/*.py
!audio_subtitles/scripts/*.mjs
!audio_subtitles/scripts/requirements*.txt
!audio_subtitles/tests/
!audio_subtitles/tests/*.py
!analysis_ppt/
!analysis_ppt/README.md
!analysis_ppt/SKILL.md
!analysis_ppt/.gitignore
!analysis_ppt/requirements*.txt
!analysis_ppt/agents/
!analysis_ppt/agents/*.yaml
!analysis_ppt/references/
!analysis_ppt/references/*.md
!analysis_ppt/prompts/
!analysis_ppt/prompts/*.md
!analysis_ppt/scripts/
!analysis_ppt/scripts/*.py
!analysis_ppt/scripts/*.mjs
!analysis_ppt/scripts/requirements*.txt
!youtube_posts/
!youtube_posts/README.md
!youtube_posts/SKILL.md
!youtube_posts/.gitignore
!youtube_posts/requirements*.txt
!youtube_posts/agents/
!youtube_posts/agents/*.yaml
!youtube_posts/references/
!youtube_posts/references/*.md
!youtube_posts/prompts/
!youtube_posts/prompts/*.md
!youtube_posts/scripts/
!youtube_posts/scripts/*.py
!youtube_posts/tests/
